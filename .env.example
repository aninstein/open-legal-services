# Local-only starter. Do not commit .env or put literal model keys in MODEL_CONFIG_JSON.
APP_PORT=8788
APP_DATA_DIR=.runtime/data
APP_COOKIE_SECURE=false
MODEL_CONFIG_JSON='[{"provider":"openai","model":"your-online-model","base_url":"https://provider.example/v1","api_key_env":"LEGAL_MODEL_API_KEY"}]'
PRIMARY_MODEL=your-online-model
LEGAL_MODEL_API_KEY=
